# ==============================================================================
# UNBRANDING Configuration Environment Variables
# Copy this file to '.env' and modify as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. User & Permission Configuration
# ------------------------------------------------------------------------------
# Set UID and GID to match your host user to avoid root-owned files in results/
UID=1000
GID=1000

# ------------------------------------------------------------------------------
# 2. Hugging Face & vLLM Server Settings
# ------------------------------------------------------------------------------
# Host path to your HuggingFace cache directory (speeds up container starts)
HF_CACHE_DIR=~/.cache/huggingface

# vLLM Docker image tag (pinning recommended for stability)
VLLM_IMAGE_TAG=latest

# HuggingFace Vision-Language Model ID to use
MODEL_ID=Qwen/Qwen3-VL-8B-Thinking

# Port on which the vLLM server will be exposed
VLLM_PORT=8000

# GPU Configuration ('all' or specific device count, e.g. 1, 2)
GPU_COUNT=all

# vLLM Server execution settings
LIMIT_MM_PER_PROMPT={"image":2}
MAX_MODEL_LEN=8192

# ------------------------------------------------------------------------------
# 3. Evaluation Runner Settings
# ------------------------------------------------------------------------------
# Dataset paths relative to the project root (workspace)
DATA_DIR=data/example/fluxdev-eraseanything-unbrand
REFERENCE_DIR=data/example/fluxdev-eraseanything-base
RESULTS_DIR=results/example
